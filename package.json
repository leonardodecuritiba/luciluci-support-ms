{
	"name": "standard-ms",
	"version": "1.0.0",
	"private": true,
	"description": "AI-first practical microservice template for the LuciLuci ecosystem.",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "ts-node-dev --respawn --transpile-only src/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/main.js",
		"start:docker": "npm run migration:run:dist && node dist/main.js",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "jest --runInBand",
		"test:unit": "jest --runInBand tests/unit",
		"test:integration": "jest --runInBand tests/integration",
		"test:contract": "jest --runInBand tests/contract",
		"test:coverage": "jest --runInBand --coverage --coverageReporters=text-summary --coverageReporters=json-summary",
		"migration:run": "ts-node -r reflect-metadata src/shared/infrastructure/database/run-migrations.ts",
		"migration:revert": "ts-node -r reflect-metadata src/shared/infrastructure/database/revert-migration.ts",
		"migration:run:dist": "node dist/shared/infrastructure/database/run-migrations.js",
		"migration:revert:dist": "node dist/shared/infrastructure/database/revert-migration.js",
		"seed": "ts-node -r reflect-metadata scripts/seed.ts",
		"infra:up": "docker compose -f docker-compose-dev.yaml up -d",
		"infra:down": "docker compose -f docker-compose-dev.yaml down -v",
		"prepare": "husky || true",
		"asyncapi:compat": "node scripts/check-asyncapi-backward-compatibility.js",
		"openapi:export": "node -r ts-node/register/transpile-only -r reflect-metadata scripts/export-openapi.js",
		"openapi:check": "node scripts/check-openapi.js docs/openapi/v1/profiles-api.json",
		"asyncapi:check": "node scripts/check-asyncapi.js docs/asyncapi/v1/standard-ms-events.json",
		"openapi:compat": "node scripts/check-openapi-backward-compatibility.js",
		"coverage:check": "node scripts/check-coverage.js coverage/coverage-summary.json"
	},
	"lint-staged": {
		"*.ts": [
			"eslint --fix",
			"prettier --write"
		],
		"*.js": [
			"prettier --write"
		],
		"*.md": [
			"prettier --write"
		],
		"*.{json,yaml,yml}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1",
		"amqplib": "^0.10.5",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"cors": "^2.8.5",
		"dotenv": "^17.2.1",
		"express": "^5.1.0",
		"openapi-types": "^12.1.3",
		"pg": "^8.16.3",
		"pino": "^9.7.0",
		"pino-pretty": "^13.1.1",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"sqlite3": "^5.1.7",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"typeorm": "^0.3.27"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@types/amqplib": "^0.10.7",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jest": "^29.5.14",
		"@types/node": "^24.3.0",
		"@types/supertest": "^6.0.3",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@typescript-eslint/eslint-plugin": "^8.41.0",
		"@typescript-eslint/parser": "^8.41.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^16.1.5",
		"prettier": "^3.6.2",
		"supertest": "^7.1.4",
		"ts-jest": "^29.4.1",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.9.2"
	}
}
