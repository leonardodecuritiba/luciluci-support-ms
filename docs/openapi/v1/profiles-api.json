{
	"components": {
		"parameters": {
			"CorrelationIdHeader": {
				"description": "Required end-to-end correlation identifier propagated across HTTP, logs and events.",
				"in": "header",
				"name": "X-Correlation-ID",
				"required": true,
				"schema": {
					"format": "uuid",
					"type": "string"
				}
			},
			"IdempotencyKeyHeader": {
				"in": "header",
				"name": "X-Idempotency-Key",
				"required": true,
				"schema": {
					"type": "string"
				}
			},
			"PerformedByHeader": {
				"in": "header",
				"name": "X-Performed-By",
				"required": false,
				"schema": {
					"type": "string"
				}
			},
			"PerformedByTypeHeader": {
				"in": "header",
				"name": "X-Performed-By-Type",
				"required": false,
				"schema": {
					"type": "string"
				}
			}
		},
		"responses": {
			"BadRequestResponse": {
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						}
					}
				},
				"description": "Request payload or headers are invalid for this operation"
			},
			"ConflictResponse": {
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						}
					}
				},
				"description": "Request conflicts with persisted state or idempotency guarantees"
			},
			"ForbiddenResponse": {
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						}
					}
				},
				"description": "Authenticated caller lacks the required role or scope"
			},
			"InternalErrorResponse": {
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						}
					}
				},
				"description": "Unexpected internal server error"
			},
			"NotFoundResponse": {
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						}
					}
				},
				"description": "Requested resource was not found"
			},
			"PayloadTooLargeResponse": {
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						}
					}
				},
				"description": "Uploaded payload exceeded the supported size"
			},
			"UnauthorizedResponse": {
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						}
					}
				},
				"description": "Authentication context is missing or invalid"
			},
			"UnsupportedMediaResponse": {
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						}
					}
				},
				"description": "Uploaded media type is not supported"
			},
			"ValidationErrorResponse": {
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/ErrorResponse"
						}
					}
				},
				"description": "Request payload failed semantic validation"
			}
		},
		"schemas": {
			"CreateProfileRequestDTO": {
				"properties": {
					"city": {
						"type": "string"
					},
					"country": {
						"type": "string"
					},
					"displayName": {
						"type": "string"
					},
					"email": {
						"format": "email",
						"type": "string"
					},
					"entityType": {
						"enum": ["individual", "organization"],
						"type": "string"
					},
					"externalId": {
						"type": "string"
					},
					"phone": {
						"type": "string"
					},
					"status": {
						"enum": ["pending", "active", "inactive", "blocked"],
						"type": "string"
					}
				},
				"required": ["externalId", "displayName", "email", "entityType"],
				"type": "object"
			},
			"ErrorItem": {
				"properties": {
					"code": {
						"type": "string"
					},
					"field": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				},
				"required": ["code"],
				"type": "object"
			},
			"ErrorResponse": {
				"properties": {
					"errors": {
						"items": {
							"$ref": "#/components/schemas/ErrorItem"
						},
						"type": "array"
					},
					"message": {
						"type": "string"
					},
					"status_code": {
						"type": "integer"
					}
				},
				"required": ["status_code", "message"],
				"type": "object"
			},
			"ListProfilesResponse": {
				"properties": {
					"data": {
						"items": {
							"$ref": "#/components/schemas/ProfileResponse"
						},
						"type": "array"
					},
					"pagination": {
						"$ref": "#/components/schemas/Pagination"
					}
				},
				"required": ["data", "pagination"],
				"type": "object"
			},
			"Pagination": {
				"properties": {
					"limit": {
						"type": "integer"
					},
					"page": {
						"type": "integer"
					},
					"total": {
						"type": "integer"
					},
					"totalPages": {
						"type": "integer"
					}
				},
				"required": ["page", "limit", "total", "totalPages"],
				"type": "object"
			},
			"ProfileResponse": {
				"properties": {
					"city": {
						"nullable": true,
						"type": "string"
					},
					"classificationIdSnapshot": {
						"nullable": true,
						"type": "string"
					},
					"classificationNameSnapshot": {
						"nullable": true,
						"type": "string"
					},
					"country": {
						"nullable": true,
						"type": "string"
					},
					"createdAt": {
						"format": "date-time",
						"type": "string"
					},
					"displayName": {
						"type": "string"
					},
					"email": {
						"type": "string"
					},
					"entityType": {
						"type": "string"
					},
					"externalId": {
						"type": "string"
					},
					"id": {
						"format": "uuid",
						"type": "string"
					},
					"phone": {
						"nullable": true,
						"type": "string"
					},
					"status": {
						"type": "string"
					},
					"updatedAt": {
						"format": "date-time",
						"type": "string"
					}
				},
				"required": [
					"id",
					"externalId",
					"displayName",
					"email",
					"entityType",
					"status",
					"createdAt",
					"updatedAt"
				],
				"type": "object"
			},
			"UpdateProfileRequestDTO": {
				"properties": {
					"city": {
						"type": "string"
					},
					"country": {
						"type": "string"
					},
					"displayName": {
						"type": "string"
					},
					"email": {
						"format": "email",
						"type": "string"
					},
					"entityType": {
						"enum": ["individual", "organization"],
						"type": "string"
					},
					"phone": {
						"type": "string"
					},
					"status": {
						"enum": ["pending", "active", "inactive", "blocked"],
						"type": "string"
					}
				},
				"type": "object"
			}
		},
		"securitySchemes": {
			"BearerAuth": {
				"bearerFormat": "JWT",
				"description": "Public authentication uses Bearer JWT issued by Identity MS. Token validation and enforcement are handled upstream by the API Gateway/BFF; this local bootstrap only accepts X-Auth-* mock headers in development/test.",
				"scheme": "bearer",
				"type": "http"
			}
		}
	},
	"info": {
		"description": "OpenAPI contract for the standard-ms template. Public authentication uses Bearer JWT via Identity MS, with validation enforced upstream by the API Gateway/BFF. The local Express bootstrap accepts X-Auth-* headers only for development and test flows.",
		"title": "standard-ms",
		"version": "1.0.0"
	},
	"openapi": "3.0.0",
	"paths": {
		"/profiles": {
			"get": {
				"parameters": [
					{
						"$ref": "#/components/parameters/CorrelationIdHeader"
					},
					{
						"in": "query",
						"name": "page",
						"schema": {
							"type": "integer"
						}
					},
					{
						"in": "query",
						"name": "limit",
						"schema": {
							"type": "integer"
						}
					},
					{
						"in": "query",
						"name": "status",
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "query",
						"name": "externalId",
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "query",
						"name": "classificationIdSnapshot",
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "query",
						"name": "displayName",
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "query",
						"name": "email",
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "query",
						"name": "entityType",
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "query",
						"name": "sortBy",
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "query",
						"name": "order",
						"schema": {
							"enum": ["ASC", "DESC"],
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ListProfilesResponse"
								}
							}
						},
						"description": "Paginated profile list"
					}
				},
				"summary": "List profiles with filters",
				"tags": ["Profiles"]
			},
			"post": {
				"parameters": [
					{
						"$ref": "#/components/parameters/CorrelationIdHeader"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKeyHeader"
					},
					{
						"$ref": "#/components/parameters/PerformedByHeader"
					},
					{
						"$ref": "#/components/parameters/PerformedByTypeHeader"
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateProfileRequestDTO"
							}
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"profileId": {
											"format": "uuid",
											"type": "string"
										}
									},
									"type": "object"
								}
							}
						},
						"description": "Profile created"
					},
					"400": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						},
						"description": "Invalid request"
					},
					"409": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						},
						"description": "Idempotency or externalId conflict"
					}
				},
				"summary": "Create a profile",
				"tags": ["Profiles"]
			}
		},
		"/profiles/{profileId}": {
			"patch": {
				"parameters": [
					{
						"$ref": "#/components/parameters/CorrelationIdHeader"
					},
					{
						"$ref": "#/components/parameters/IdempotencyKeyHeader"
					},
					{
						"$ref": "#/components/parameters/PerformedByHeader"
					},
					{
						"$ref": "#/components/parameters/PerformedByTypeHeader"
					},
					{
						"in": "path",
						"name": "profileId",
						"required": true,
						"schema": {
							"format": "uuid",
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/UpdateProfileRequestDTO"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"profileId": {
											"format": "uuid",
											"type": "string"
										},
										"updatedAt": {
											"format": "date-time",
											"type": "string"
										},
										"updatedFields": {
											"items": {
												"type": "string"
											},
											"type": "array"
										}
									},
									"type": "object"
								}
							}
						},
						"description": "Profile updated"
					},
					"404": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						},
						"description": "Profile not found"
					}
				},
				"summary": "Update editable profile fields",
				"tags": ["Profiles"]
			}
		},
		"/profiles/by-external-id/{externalId}": {
			"get": {
				"parameters": [
					{
						"$ref": "#/components/parameters/CorrelationIdHeader"
					},
					{
						"in": "path",
						"name": "externalId",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ProfileResponse"
								}
							}
						},
						"description": "Profile found"
					},
					"404": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						},
						"description": "Profile not found"
					}
				},
				"summary": "Find profile by externalId",
				"tags": ["Profiles"]
			}
		}
	},
	"tags": []
}
