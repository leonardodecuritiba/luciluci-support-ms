{
	"components": {
		"parameters": {
			"CorrelationIdHeader": {
				"in": "header",
				"name": "X-Correlation-ID",
				"required": true,
				"schema": { "format": "uuid", "type": "string" }
			},
			"PerformedByHeader": {
				"in": "header",
				"name": "X-Performed-By",
				"required": true,
				"schema": { "pattern": ".*\\S.*", "type": "string" }
			},
			"PerformedByTypeHeader": {
				"in": "header",
				"name": "X-Performed-By-Type",
				"required": true,
				"schema": { "enum": ["admin", "backoffice", "cd"], "type": "string" }
			}
		},
		"schemas": {
			"CreateDepartmentRequest": {
				"additionalProperties": false,
				"properties": {
					"allowedUserIds": {
						"items": { "pattern": ".*\\S.*", "type": "string" },
						"type": "array"
					},
					"name": { "pattern": ".*\\S.*", "type": "string" },
					"type": { "$ref": "#/components/schemas/DepartmentType" }
				},
				"required": ["name", "type"],
				"type": "object"
			},
			"CreatedTicket": {
				"additionalProperties": false,
				"properties": {
					"adminStatus": { "enum": ["pendente"], "type": "string" },
					"createdAt": { "format": "date-time", "type": "string" },
					"departmentId": { "format": "uuid", "type": "string" },
					"id": { "format": "uuid", "type": "string" },
					"number": { "minimum": 1, "type": "integer" },
					"origin": { "$ref": "#/components/schemas/TicketOrigin" },
					"priority": { "$ref": "#/components/schemas/TicketPriority" },
					"requesterId": { "type": "string" },
					"requesterStatus": { "enum": ["nao_resolvido"], "type": "string" },
					"subject": { "type": "string" },
					"updatedAt": { "format": "date-time", "type": "string" }
				},
				"required": [
					"id",
					"number",
					"subject",
					"requesterId",
					"departmentId",
					"priority",
					"origin",
					"adminStatus",
					"requesterStatus",
					"createdAt",
					"updatedAt"
				],
				"type": "object"
			},
			"CreateInitialTicketMessageRequest": {
				"additionalProperties": false,
				"properties": {
					"mediaIds": {
						"items": { "pattern": ".*\\S.*", "type": "string" },
						"type": "array"
					},
					"message": { "pattern": ".*\\S.*", "type": "string" }
				},
				"required": ["message"],
				"type": "object"
			},
			"CreateTicketRequest": {
				"additionalProperties": false,
				"properties": {
					"departmentId": { "format": "uuid", "type": "string" },
					"message": { "$ref": "#/components/schemas/CreateInitialTicketMessageRequest" },
					"origin": { "$ref": "#/components/schemas/TicketOrigin" },
					"priority": { "$ref": "#/components/schemas/TicketPriority" },
					"requesterId": { "pattern": ".*\\S.*", "type": "string" },
					"subject": { "pattern": ".*\\S.*", "type": "string" }
				},
				"required": [
					"subject",
					"requesterId",
					"departmentId",
					"priority",
					"origin",
					"message"
				],
				"type": "object"
			},
			"Department": {
				"properties": {
					"active": { "type": "boolean" },
					"allowedUserIds": { "items": { "type": "string" }, "type": "array" },
					"createdAt": { "format": "date-time", "type": "string" },
					"id": { "format": "uuid", "type": "string" },
					"name": { "type": "string" },
					"type": { "$ref": "#/components/schemas/DepartmentType" },
					"updatedAt": { "format": "date-time", "type": "string" }
				},
				"required": [
					"id",
					"name",
					"allowedUserIds",
					"type",
					"active",
					"createdAt",
					"updatedAt"
				],
				"type": "object"
			},
			"DepartmentListResponse": {
				"additionalProperties": false,
				"properties": {
					"data": {
						"items": { "$ref": "#/components/schemas/Department" },
						"type": "array"
					},
					"pagination": { "$ref": "#/components/schemas/Pagination" }
				},
				"required": ["data", "pagination"],
				"type": "object"
			},
			"DepartmentType": { "enum": ["todos", "backoffice", "cd"], "type": "string" },
			"ErrorResponse": {
				"properties": {
					"errors": { "items": { "type": "object" }, "type": "array" },
					"message": { "type": "string" },
					"status_code": { "type": "integer" }
				},
				"required": ["status_code", "message"],
				"type": "object"
			},
			"Pagination": {
				"additionalProperties": false,
				"properties": {
					"page": { "minimum": 1, "type": "integer" },
					"size": { "maximum": 100, "minimum": 1, "type": "integer" },
					"total": { "minimum": 0, "type": "integer" },
					"totalPages": { "minimum": 0, "type": "integer" }
				},
				"required": ["page", "size", "total", "totalPages"],
				"type": "object"
			},
			"Ticket": {
				"additionalProperties": false,
				"properties": {
					"adminStatus": { "$ref": "#/components/schemas/TicketAdminStatus" },
					"createdAt": { "format": "date-time", "type": "string" },
					"departmentId": { "format": "uuid", "type": "string" },
					"id": { "format": "uuid", "type": "string" },
					"number": { "minimum": 1, "type": "integer" },
					"origin": { "$ref": "#/components/schemas/TicketOrigin" },
					"priority": { "$ref": "#/components/schemas/TicketPriority" },
					"requesterId": { "type": "string" },
					"requesterStatus": { "enum": ["nao_resolvido"], "type": "string" },
					"subject": { "type": "string" },
					"updatedAt": { "format": "date-time", "type": "string" }
				},
				"required": [
					"id",
					"number",
					"subject",
					"requesterId",
					"departmentId",
					"priority",
					"origin",
					"adminStatus",
					"requesterStatus",
					"createdAt",
					"updatedAt"
				],
				"type": "object"
			},
			"TicketAdminStatus": {
				"enum": ["pendente", "cancelado", "em_andamento", "finalizado", "resolvido"],
				"type": "string"
			},
			"TicketDetail": {
				"additionalProperties": false,
				"properties": {
					"adminStatus": { "$ref": "#/components/schemas/TicketAdminStatus" },
					"createdAt": { "format": "date-time", "type": "string" },
					"departmentId": { "format": "uuid", "type": "string" },
					"id": { "format": "uuid", "type": "string" },
					"number": { "minimum": 1, "type": "integer" },
					"origin": { "$ref": "#/components/schemas/TicketOrigin" },
					"priority": { "$ref": "#/components/schemas/TicketPriority" },
					"requesterId": { "type": "string" },
					"requesterStatus": { "enum": ["nao_resolvido", "resolvido"], "type": "string" },
					"subject": { "type": "string" },
					"updatedAt": { "format": "date-time", "type": "string" }
				},
				"required": [
					"id",
					"number",
					"subject",
					"requesterId",
					"departmentId",
					"priority",
					"origin",
					"adminStatus",
					"requesterStatus",
					"createdAt",
					"updatedAt"
				],
				"type": "object"
			},
			"TicketListItem": {
				"additionalProperties": false,
				"properties": {
					"createdAt": { "format": "date-time", "type": "string" },
					"departmentId": { "format": "uuid", "type": "string" },
					"id": { "format": "uuid", "type": "string" },
					"number": { "minimum": 1, "type": "integer" },
					"origin": { "$ref": "#/components/schemas/TicketOrigin" },
					"priority": { "$ref": "#/components/schemas/TicketPriority" },
					"requesterId": { "type": "string" },
					"status": { "$ref": "#/components/schemas/TicketAdminStatus" }
				},
				"required": [
					"id",
					"number",
					"createdAt",
					"departmentId",
					"requesterId",
					"origin",
					"priority",
					"status"
				],
				"type": "object"
			},
			"TicketListResponse": {
				"additionalProperties": false,
				"properties": {
					"data": {
						"items": { "$ref": "#/components/schemas/TicketListItem" },
						"type": "array"
					},
					"pagination": { "$ref": "#/components/schemas/Pagination" }
				},
				"required": ["data", "pagination"],
				"type": "object"
			},
			"TicketOrigin": { "enum": ["backoffice", "cd"], "type": "string" },
			"TicketPriority": { "enum": ["baixa", "media", "alta", "urgente"], "type": "string" },
			"UpdateDepartmentRequest": {
				"additionalProperties": false,
				"minProperties": 1,
				"properties": {
					"allowedUserIds": {
						"items": { "pattern": ".*\\S.*", "type": "string" },
						"type": "array"
					},
					"name": { "pattern": ".*\\S.*", "type": "string" },
					"type": { "$ref": "#/components/schemas/DepartmentType" }
				},
				"type": "object"
			},
			"UpdateTicketRequest": {
				"additionalProperties": false,
				"minProperties": 1,
				"properties": {
					"adminStatus": { "$ref": "#/components/schemas/TicketAdminStatus" },
					"departmentId": { "format": "uuid", "type": "string" },
					"priority": { "$ref": "#/components/schemas/TicketPriority" }
				},
				"type": "object"
			}
		}
	},
	"info": {
		"description": "Support OpenAPI contract. RF01–RF04 manage departments, RF05 creates tickets, RF06 edits tickets, RF07a/RF07b list tickets, RF08 resolves tickets, and RF09 reads tickets by ID; RF10–RF13 remain unavailable.",
		"title": "support-ms",
		"version": "1.0.0"
	},
	"openapi": "3.0.0",
	"paths": {
		"/api-docs": {
			"get": {
				"responses": {
					"200": {
						"content": { "text/html": { "schema": { "type": "string" } } },
						"description": "Interactive OpenAPI documentation."
					}
				},
				"summary": "Swagger UI"
			}
		},
		"/api-docs-json": {
			"get": {
				"responses": {
					"200": {
						"content": { "application/json": { "schema": { "type": "object" } } },
						"description": "Current OpenAPI document."
					}
				},
				"summary": "OpenAPI document"
			}
		},
		"/api/support/departments": {
			"get": {
				"description": "Returns active departments ordered by name ASC and id ASC. Page and size decisions are specific to RF03.",
				"parameters": [
					{ "$ref": "#/components/parameters/CorrelationIdHeader" },
					{
						"in": "query",
						"name": "type",
						"required": false,
						"schema": { "$ref": "#/components/schemas/DepartmentType" }
					},
					{
						"in": "query",
						"name": "page",
						"required": false,
						"schema": { "default": 1, "minimum": 1, "type": "integer" }
					},
					{
						"in": "query",
						"name": "size",
						"required": false,
						"schema": { "default": 20, "maximum": 100, "minimum": 1, "type": "integer" }
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/DepartmentListResponse" }
							}
						},
						"description": "Active departments page."
					},
					"400": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Missing or invalid correlation."
					},
					"422": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Invalid or unknown query parameter."
					},
					"500": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Unexpected error."
					}
				},
				"summary": "List active departments",
				"tags": ["Departments"]
			},
			"post": {
				"parameters": [{ "$ref": "#/components/parameters/CorrelationIdHeader" }],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/CreateDepartmentRequest" }
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/Department" }
							}
						},
						"description": "Department created."
					},
					"400": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Malformed JSON or missing correlation."
					},
					"422": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Invalid request body."
					},
					"500": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Unexpected error."
					}
				},
				"summary": "Create a department",
				"tags": ["Departments"]
			}
		},
		"/api/support/departments/{departmentId}": {
			"delete": {
				"description": "Sets active=false while preserving the department and its memberships. Repeating the operation for an inactive department is a successful no-op. RF03 continues to return only active departments. This operation creates no audit log or domain event.",
				"parameters": [
					{ "$ref": "#/components/parameters/CorrelationIdHeader" },
					{
						"in": "path",
						"name": "departmentId",
						"required": true,
						"schema": { "format": "uuid", "type": "string" }
					}
				],
				"responses": {
					"204": { "description": "Department soft deleted or already inactive." },
					"400": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Missing or invalid correlation."
					},
					"404": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Department not found."
					},
					"422": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Invalid path or forbidden request body."
					},
					"500": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Unexpected error."
					}
				},
				"summary": "Soft delete a department",
				"tags": ["Departments"]
			},
			"patch": {
				"parameters": [
					{ "$ref": "#/components/parameters/CorrelationIdHeader" },
					{
						"in": "path",
						"name": "departmentId",
						"required": true,
						"schema": { "format": "uuid", "type": "string" }
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UpdateDepartmentRequest" }
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/Department" }
							}
						},
						"description": "Department updated."
					},
					"400": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Malformed JSON or missing correlation."
					},
					"404": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Department not found."
					},
					"422": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Invalid path or request body."
					},
					"500": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Unexpected error."
					}
				},
				"summary": "Update a department",
				"tags": ["Departments"]
			}
		},
		"/api/support/tickets": {
			"post": {
				"description": "Atomically creates one Ticket, one initial TicketMessage, zero or more ordered media references, and exactly one criacao_ticket audit. The department row is locked during the transaction; inactive departments return department_inactive.",
				"parameters": [{ "$ref": "#/components/parameters/CorrelationIdHeader" }],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/CreateTicketRequest" }
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/CreatedTicket" }
							}
						},
						"description": "Ticket aggregate created."
					},
					"400": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Malformed JSON or missing/invalid correlation."
					},
					"404": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Department not found."
					},
					"422": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Invalid request body or inactive department (department_inactive)."
					},
					"500": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Unexpected error; aggregate transaction is rolled back."
					}
				},
				"summary": "Create a ticket with its initial message",
				"tags": ["Tickets"]
			}
		},
		"/api/support/tickets/{ticketId}": {
			"get": {
				"description": "RF09. Admin requires current Department membership; backoffice and cd require requester ownership. Inactive Departments remain readable. Read-only, without audit or side effects. Query parameters and request body are forbidden.",
				"parameters": [
					{ "$ref": "#/components/parameters/CorrelationIdHeader" },
					{ "$ref": "#/components/parameters/PerformedByHeader" },
					{ "$ref": "#/components/parameters/PerformedByTypeHeader" },
					{
						"in": "path",
						"name": "ticketId",
						"required": true,
						"schema": {
							"format": "uuid",
							"pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/TicketDetail" }
							}
						},
						"description": "Complete Ticket without expanded relations."
					},
					"400": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Missing or invalid correlation/actor headers."
					},
					"403": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Current Department membership or requester ownership denied."
					},
					"404": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Ticket not found."
					},
					"422": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Invalid ticketId, any query parameter, or any present body."
					},
					"500": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Unexpected error."
					}
				},
				"summary": "Get a Ticket by ID",
				"tags": ["Tickets"]
			},
			"patch": {
				"description": "Locks Ticket, then relevant Departments in UUID order. Admin needs current and target membership; requester needs ownership. No-op preserves updatedAt. A changed adminStatus writes one audit in the transaction.",
				"parameters": [
					{ "$ref": "#/components/parameters/CorrelationIdHeader" },
					{ "$ref": "#/components/parameters/PerformedByHeader" },
					{ "$ref": "#/components/parameters/PerformedByTypeHeader" },
					{
						"in": "path",
						"name": "ticketId",
						"required": true,
						"schema": { "format": "uuid", "type": "string" }
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UpdateTicketRequest" }
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/Ticket" }
							}
						},
						"description": "Complete Ticket after update or no-op."
					},
					"400": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Missing or invalid correlation/actor headers or malformed JSON."
					},
					"403": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Current Ticket or target Department access denied."
					},
					"404": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Ticket or target Department not found."
					},
					"422": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ErrorResponse" }
							}
						},
						"description": "Invalid path/body or inactive target (department_inactive)."
					},
					"500": {
						"content": {
							"application/json": {
