# support-ms bootstrap API requests
#
# S1 exposes only operational surfaces. RF01–RF13 are not implemented.

@baseUrl = http://localhost:3000
@correlationId = 8a7dd7bb-7b3f-4b3b-8b8e-0b7e2819d001

### Health
GET {{baseUrl}}/health

### RF01 - Create department
POST {{baseUrl}}/api/support/departments
Content-Type: application/json
X-Correlation-ID: 8021b0b0-5855-4c1c-8086-85bba8f4ec94

{
  "name": "Financeiro",
  "allowedUserIds": ["uid-user-1", "uid-user-2"],
  "type": "todos"
}
Accept: application/json

### Metrics
GET {{baseUrl}}/metrics
Accept: text/plain

### OpenAPI JSON
GET {{baseUrl}}/api-docs-json
Accept: application/json

### OpenAPI UI
GET {{baseUrl}}/api-docs
Accept: text/html
